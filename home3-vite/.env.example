# Where your Next dashboard backend is running (npm run dev → server-v2/server-with-proxy.js).
# The Vite dev server proxies /ws/gex, /proxy/*, /api/* here so live GEX data flows in.
# server-v2/server-with-proxy.js binds PORT || 3001 and serves the site,
# /ws/gex, /proxy/* and /api/* all on that one port. Match it here (or set PORT).
VITE_BACKEND=http://localhost:3001
