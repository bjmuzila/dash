{
  "name": "cbedge-v3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/check-theme.mjs && vite build && node scripts/check-budgets.mjs",
    "build:fast": "vite build",
    "budgets": "node scripts/check-budgets.mjs",
    "budgets:ratchet": "node scripts/check-budgets.mjs --ratchet",
    "check:theme": "node scripts/check-theme.mjs",
    "theme:fix": "node scripts/check-theme.mjs --fix",
    "theme:update": "node scripts/check-theme.mjs --update",
    "mock": "node scripts/mock-server.mjs 4310",
    "lab": "node tools/bubble-lab/build.mjs",
    "lab:watch": "node tools/bubble-lab/build.mjs --watch",
    "lab:capture": "node tools/bubble-lab/capture.mjs",
    "check:ws": "node scripts/ws-scope-check.mjs",
    "perf": "node scripts/perf-check.mjs",
    "check:casing": "node scripts/check-casing.mjs",
    "check:parity": "node scripts/parity-check.mjs",
    "check:parity:self": "node scripts/parity-check.test.mjs",
    "check:parity:chain": "node scripts/parity-check-chain.mjs",
    "check:parity:chain:self": "node scripts/parity-check-chain.test.mjs",
    "check:parity:flow": "node scripts/parity-check-flow.mjs",
    "check:parity:flow:self": "node scripts/parity-check-flow.test.mjs",
    "check:parity:analysis": "node scripts/parity-check-analysis.mjs",
    "check:parity:analysis:self": "node scripts/parity-check-analysis.test.mjs",
    "check:parity:em": "node scripts/parity-check-em.mjs",
    "check:parity:em:self": "node scripts/parity-check-em.test.mjs",
    "check:parity:replay": "node scripts/parity-check-replay.mjs",
    "check:parity:replay:self": "node scripts/parity-check-replay.test.mjs",
    "check": "npm run check:casing && npm run typecheck && npm run check:theme && npm run build:fast && npm run budgets && npm run check:ws && npm run perf && npm run check:parity:self && npm run check:parity:chain:self && npm run check:parity:flow:self && npm run check:parity:analysis:self && npm run check:parity:em:self && npm run check:parity:replay:self",
    "preview": "vite preview --port 4173"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.1.14",
    "typescript": "5.9",
    "vite": "^7.1.9"
  }
}
