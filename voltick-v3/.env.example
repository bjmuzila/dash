# Copy to .env.local
#
# Where `npm run dev` proxies /api, /proxy and /ws to. Point it at the live
# VPS so you develop against real data, or at a local server-v2 if you have
# one running.
VITE_BACKEND_ORIGIN=http://178.156.137.36

# The WebSocket is always same-origin (/ws/gex) and is proxied to the origin
# above in dev. There is deliberately no separate WS URL setting — one host,
# one source of truth, no way for the early-boot socket and the app's own
# reconnects to disagree.
