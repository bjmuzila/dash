# Where the Next backend is served. app-vite talks to it over relative URLs
# (/api, /proxy, /ws), proxied in dev so there is no CORS.
#   local dev backend : http://localhost:3001
#   live (recommended): https://cbedge.net   (local /ws/gex is unreliable off-hours)
VITE_BACKEND=http://localhost:3001

# PROD ONLY: cbedge.net is paywalled + WS-auth-gated. Paste an authenticated
# cbedge.net `document.cookie` so the dev proxy passes the gate. Not VITE_-prefixed
# → stays server-side in vite.config, never shipped to the browser bundle.
# BACKEND_COOKIE=cbe_session=...
# BACKEND_TOKEN=
