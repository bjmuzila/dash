                         "bcryptjs":  "^2.4.3",
                         "clsx":  "^2.1.1",
                         "discord.js":  "^13.17.1",
                         "dotenv":  "^17.4.2",
                         "googleapis":  "^173.0.0",
                         "html2canvas":  "^1.4.1",
                         "lightweight-charts":  "^5.0.0",
                         "next":  "^15.5.9",
