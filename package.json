                         "postcss":  "^8.4.38",
                         "puppeteer":  "^24.0.0",
                         "react":  "^19",
                         "react-dom":  "^19",
                         "stripe":  "^22.3.0",
                         "tailwind-merge":  "^2.3.0",
                         "tailwindcss":  "^3.4.3",
                         "tesseract.js":  "^5.1.1",
                         "typescript":  "^5",
                         "ws":  "^8.18.0",
                         "xlsx":  "^0.18.5"
                     },
