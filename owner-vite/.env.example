# Where your Next dashboard backend is running (repo-root `npm run dev`).
# The Vite dev server proxies /ws/*, /proxy/*, /api/* here so owner data flows in.
VITE_BACKEND=http://localhost:3001

# PROD only — owner routes are auth-gated. Copy document.cookie from an
# authenticated cbedge.net tab so the proxy presents your session.
# BACKEND_COOKIE=
# BACKEND_TOKEN=
